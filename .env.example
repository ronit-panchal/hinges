# ====================================================================
# HINGES: PRODUCTION ENVIRONMENT CONFIGURATION
# ====================================================================

# Supabase Project URL & Anon/Publishable Key
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Service Role Key (Required only for administrative maintenance scripts)
# NEVER expose this key to client components or commit to version control!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Base Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

